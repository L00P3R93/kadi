APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Shared KadiApi customer-ID encryption key (AES-256-GCM). REQUIRED outside local.
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# Must match the key configured on the KadiApi service; rotate on both sides together.
OPENSSL_KEY=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

# Reverb (real-time broadcasting, e.g. instant wallet balance updates). See docs/wallet-webhook.md.
# Generate app id/key/secret per environment (php artisan reverb:install, or your own random values).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# PHP -> Reverb (server-to-server publish). Internal only, never proxied or exposed publicly.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
# Where Reverb actually binds/listens (reverb:start). Loopback only; Apache proxies to it in production.
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
# Browser -> Reverb, proxied on the public domain (Apache, mod_proxy_wstunnel). See docs/wallet-webhook.md.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=kadi.online
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# WebAuthn passkeys (Fortify). Secret used to derive per-user WebAuthn user handles.
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# Rotating this invalidates all registered passkeys.
PASSKEYS_USER_HANDLE_SECRET=

# External Kadi play site linked from the dashboard.
KADI_PLAY_URL=https://kadi.online

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX) and Search Console
# HTML-tag verification code. Leave blank to disable both.
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

VITE_APP_NAME="${APP_NAME}"

# Web Push (PWA notifications). Generate the key pair once per environment with:
#   php artisan webpush:vapid
# On Windows/Herd, generating keys needs OPENSSL_CONF pointing at your PHP openssl.cnf (only for
# `webpush:vapid`; sending pushes works without it). See docs/pwa-push.md.
# Never share or commit the private key; rotating it invalidates every existing subscription.
VAPID_SUBJECT="mailto:admin@example.com"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Push API (server-to-server: lets the game server send push notifications to players).
# See docs/push-api.md. Generate a key with `php artisan push-api:key` and put ONLY its hash here.
# Empty means the API is disabled (every request is refused). Two comma-separated hashes = key rotation.
PUSH_API_KEY_HASHES=
# Optional: only these caller IPs may use it (comma separated). Empty = any IP with a valid key.
PUSH_API_ALLOWED_IPS=
# The API may send `urgency: high` (delivered to sleeping phones at once). Set to false to refuse it.
PUSH_API_ALLOW_HIGH_URGENCY=true
# System-wide broadcasts to every registered device use a SEPARATE key (generate with `php artisan push-api:key --broadcast`).
# Empty disables broadcasts. Caps: PUSH_API_BROADCAST_PER_HOUR (per key, default 6), PUSH_API_BROADCAST_PER_DAY (total, default 4).
PUSH_API_BROADCAST_KEY_HASHES=
# Optional: send broadcasts on their own queue (needs a worker on it, see docs/push-api.md). Empty = the default queue.
PUSH_API_BROADCAST_QUEUE=

# Wallet webhook (KadiApi -> this site: pushes wallet balance changes). See docs/wallet-webhook.md.
# Raw shared secret(s), comma separated (list two while rotating). Empty means the endpoint is disabled.
KADI_WALLET_WEBHOOK_SECRETS=

# Game history and disputes (see docs/game-disputes.md). KadiApi path for a player's latest 10 games of each kind.
KADI_PLAYED_GAMES_ENDPOINT=
